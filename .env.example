# Copy to .env to override. Defaults match docker-compose.yml.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# gemma3 (vision-capable): reads merchant/amount/date/reference from PDFs and photos, and writes the letter
OLLAMA_LLM_MODEL=gemma3:4b
# EmbeddingGemma 2 (multimodal). Matching uses only this model; there is no substitute.
# Keep an image-capable tag (embeddinggemma-2 / :740m / :440m) so JPEG evidence can be matched.
OLLAMA_EMBED_MODEL=embeddinggemma-2
OLLAMA_NIMBLE_PATH=/v1/systemone
OLLAMA_TIMEOUT_SECONDS=180
# Letter only: false = fail the case instead of using the template letter when gemma3 is unavailable
ALLOW_OFFLINE_FALLBACK=true
# Where the backend keeps the Chroma vector store (the compose file mounts a named volume here)
CHROMA_DIR=/data/chroma
